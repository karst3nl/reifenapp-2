[Unit]
Description=Reifenapp 2.0 - lokale Reifenlagerverwaltung
Wants=network-online.target
After=network-online.target cups.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=reifenapp
Group=reifenapp
WorkingDirectory=/var/lib/reifenapp
StateDirectory=reifenapp
StateDirectoryMode=0700
Environment=REIFENAPP_ADDR=0.0.0.0:8080
EnvironmentFile=-/etc/reifenapp/reifenapp.env
ExecStart=/opt/reifenapp/bin/reifenapp -addr ${REIFENAPP_ADDR}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/reifenapp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
